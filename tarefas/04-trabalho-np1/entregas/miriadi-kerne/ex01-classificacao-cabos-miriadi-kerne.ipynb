# Exercício 01: Classificação de Carga em Cabos
# Aluna: Miriadi Maira Antunes Kerne

def classificar_carga(carga_kn):
    if carga_kn < 0:
        return "Erro: A carga não pode ser negativa."
    elif carga_kn <= 50.0:
        return "Carga Baixa (Seguro para operação padrão)"
    elif carga_kn <= 150.0:
        return "Carga Média (Requer monitoramento periódico)"
    elif carga_kn <= 300.0:
        return "Carga Alta (Atenção: Limite operacional próximo)"
    else:
        return "Carga Crítica (Risco iminente de ruptura - Parar operação)"

# Exemplo de teste da função
carga_atual = 180.5
resultado = classificar_carga(carga_atual)
print(f"Carga informada: {carga_atual} kN")
print(f"Classificação: {resultado}")
