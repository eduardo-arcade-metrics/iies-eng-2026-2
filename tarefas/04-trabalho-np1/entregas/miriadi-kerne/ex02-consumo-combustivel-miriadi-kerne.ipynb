# Exercício 02: Consumo de Combustível em Rotação
# Aluna: Miriadi Maira Antunes Kerne

# Lista de rotações (RPM) testadas em diferentes instantes
rotacoes_rpm = [1200, 1800, 2400, 3000, 3600]

# Fator base de consumo em litros por hora por RPM
fator_consumo = 0.0015

consumo_total = 0.0

print("Relatório de Consumo por Rotação:")
for rpm in rotacoes_rpm:
    consumo_instantenio = rpm * fator_consumo
    consumo_total += consumo_instantenio
    print(f"- Rotação: {rpm} RPM | Consumo estimado: {consumo_instantenio:.2f} L/h")

print(f"\nConsumo acumulado total do teste: {consumo_total:.2f} litros")
