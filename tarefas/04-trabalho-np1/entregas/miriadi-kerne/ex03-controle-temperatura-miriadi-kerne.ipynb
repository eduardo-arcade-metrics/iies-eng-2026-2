# Exercício 03: Controle de Temperatura do Reator
# Aluna: Miriadi Maira Antunes Kerne

temperatura_atual = 115.5
temperatura_segura = 80.0

print(f"Início do monitoramento. Temperatura inicial: {temperatura_atual}°C")

ciclo = 1
while temperatura_atual > temperatura_segura:
    print(f"Ciclo {ciclo}: Temperatura alta ({temperatura_atual:.1f}°C). Acionando sistema de refrigeração...")
    # Reduz 7.5°C a cada ciclo de resfriamento
    temperatura_atual -= 7.5
    ciclo += 1

print(f"\nTemperatura estabilizada em {temperatura_atual:.1f}°C. Sistema seguro.")
